# Local timezone used by the Pi-hole container
TZ=Europe/Athens

# Choose a strong password.
# Never commit your real password to GitHub.
PIHOLE_PASSWORD=replace-with-a-strong-password

# Static LAN address assigned to Pi-hole through macvlan
PIHOLE_IP=192.168.1.2

# Static address on the pihole_outbound bridge (must be inside its subnet,
# 172.18.0.0/16 in this guide, and must not be the gateway 172.18.0.1)
PIHOLE_OUTBOUND_IP=172.18.0.2

# Pi-hole v6 upstream DNS servers
# Separate multiple servers with semicolons.
DNS_UPSTREAMS=9.9.9.9;149.112.112.112

# Pi-hole DNS listening mode: LOCAL (default, LAN only) or ALL
# (also answer clients on other routed OpenWrt subnets such as a guest VLAN).
DNS_LISTENING_MODE=LOCAL

# Pi-hole image tag. "latest" follows the official guide.
# Set a date-based tag (for example 2026.10.1) to pin or roll back a release.
# Tags: https://hub.docker.com/r/pihole/pihole/tags
PIHOLE_TAG=latest
